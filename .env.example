# API base URL (required, no trailing slash). Used by /api/proxy to forward requests.
NEXT_PUBLIC_API_BASE_URL=https://chaad-energy-backend.vercel.app/api

# Canonical base URL for SEO and Open Graph (required)
NEXT_PUBLIC_SITE_URL=https://chaadenergy.com

# Optional: Twitter handle for cards (e.g. @chaadenergy)
NEXT_PUBLIC_TWITTER_HANDLE=@chaadenergy
